#include <dt-bindings/zmk/mouse.h>
#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            timeout-ms = <50>;
        };

        ZenHan {
            bindings = <&kp LC(SPACE)>;
            key-positions = <12 13>;
            timeout-ms = <50>;
        };

        Num-Dot-Combo {
            bindings = <&kp DOT>;
            key-positions = <27 28>;
            timeout-ms = <20>;
            layers = <4>;
        };

        ndq {
            bindings = <&ndq_id_macro>;
            key-positions = <1 2>;
            layers = <1>;
        };

        pc {
            bindings = <&PC_macro>;
            key-positions = <2 3>;
            layers = <1>;
        };

        zaq {
            bindings = <&zaq_macro>;
            key-positions = <4 3>;
            layers = <1>;
        };

        sysop {
            bindings = <&sysop_macro>;
            key-positions = <1 3>;
            layers = <1>;
        };

        LayerRise {
            bindings = <&mo 6>;
            key-positions = <33 26>;
            layers = <0>;
        };

        LayerFun {
            bindings = <&mo 5>;
            key-positions = <30 23>;
            layers = <0>;
        };

        LayerADJUST {
            bindings = <&mo 8>;
            key-positions = <31 24>;
            layers = <0>;
        };
    };

    macros {
        zaq_macro: zaq_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp A &kp Q &kp N1 &kp DQT &kp LS(W) &kp LS(S) &kp LS(X)>;
            label = "ZAQ_MACRO";
        };

        ndq_id_macro: nsq_id_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N4 &kp N4 &kp N5 &kp N6 &kp N3 &kp N6 &kp N0>;
            label = "NSQ_ID_MACRO";
        };

        PC_macro: PC_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp S &kp D &kp F &kp SEMI &kp L &kp K &kp J>;
            label = "PC_MACRO";
        };

        sysop_macro: sysop_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp Y &kp S &kp O &kp P &kp N0 &kp N0 &kp N0>;
            label = "SYSOP_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T            &kp Y                  &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G            &kp H                  &kp J  &kp K      &kp L    &kp MINUS
&kp Z  &kp X  &kp C  &kp V  &kp B            &kp N                  &kp M  &kp COMMA  &kp DOT  &lt 5 SLASH
                     &mt MO(1) sticky_alt  &mt RCTRL SPACE  &mt RIGHT_SHIFT ENTER  &mo 2
            >;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&sk LWIN      &sk LSHIFT  &sk LEFT_ALT   &sk LCTRL   &none            &kp C_AL_SCREENSAVER  &kp PAUSE_BREAK  &kp MINUS         &kp EQUAL          &none
&kp CAPSLOCK  &kp TAB     &kp BACKSPACE  &kp ESCAPE  &kp DELETE       &kp SCROLLLOCK        &none            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&kp LWIN      &kp LSHFT   &kp LEFT_ALT   &kp LCTRL   &kp PRINTSCREEN  &none                 &none            &kp SEMICOLON     &kp SQT            &kp BACKSLASH
                                         &trans      &trans           &trans                &mo 3
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&kp ESCAPE    &mkp LCLK       &mkp MCLK     &mkp RCLK  &kp C_AC_HOME  &mkp MCLK        &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP
&kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &kp END        &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&none         &none           &kp INSERT    &kp PG_UP  &kp PAGE_DOWN  &msc SCRL_RIGHT  &kp LEFT        &kp DOWN        &kp UP           &kp RIGHT
                                            &mo 4      &trans         &trans           &trans
            >;
        };

        rmod_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R   &kp T   &kp Y   &kp U      &kp I          &kp O      &kp P
&kp A  &kp S  &kp D  &kp F   &kp G   &kp H   &kp RCTRL  &kp RIGHT_ALT  &kp RSHFT  &kp RIGHT_GUI
&kp Z  &kp X  &kp C  &kp V   &kp B   &kp N   &kp RCTRL  &kp RIGHT_ALT  &kp RSHFT  &kp RIGHT_GUI
                     &trans  &trans  &trans  &trans
            >;
        };

        lmod_layer {
            bindings = <
&kp Q         &kp W           &kp E          &kp R      &kp T   &kp Y   &kp U   &kp I      &kp O       &kp P
&kp LEFT_GUI  &kp LEFT_SHIFT  &kp LALT       &kp LCTRL  &kp G   &kp H   &kp J   &kp K      &kp L       &kp MINUS
&kp LEFT_GUI  &kp LEFT_SHIFT  &kp RIGHT_ALT  &kp LCTRL  &kp B   &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH
                                             &trans     &trans  &trans  &trans
            >;
        };

        func_layer {
            display-name = "func";
            bindings = <
&kp F10       &kp F11         &kp F12       &none      &none   &none          &kp F7  &kp F8  &kp F9  &none
&kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &none   &kp PAGE_UP    &kp F4  &kp F5  &kp F6  &tog 7
&none         &none           &none         &trans     &trans  &kp PAGE_DOWN  &kp F1  &kp F2  &kp F3  &trans
                                            &trans     &trans  &trans         &trans
            >;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp K_PREV    &kp K_STOP     &kp K_PP      &kp K_NEXT    &none         &none         &none
&kp LWIN      &kp LEFT_SHIFT     &kp LEFT_ALT  &kp LCTRL     &kp LC(LS(O))  &none         &trans        &kp RALT      &kp RSHFT     &kp RIGHT_GUI
                                               &trans        &trans         &trans        &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&none         &none           &kp UP_ARROW    &none            &none      &kp SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
&none         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &kp ASTERISK  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT    &kp LCTRL        &none      &kp KP_N0     &kp KP_N1  &kp KP_N2  &kp KP_N3  &tog 7
                                              &kp TAB          &kp SPACE  &kp KP_ENTER  &none
            >;
        };

        adjust_layer {
            bindings = <
&bootloader   &sys_reset    &none         &bt BT_CLR    &bt BT_CLR_ALL  &sys_reset      &none  &none  &none  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &out OUT_TOG    &none  &none  &none  &none
&out OUT_USB  &out OUT_BLE  &bt BT_PRV    &bt BT_NXT    &trans          &studio_unlock  &none  &none  &none  &none
                                          &none         &trans          &none           &none
            >;
        };
    };
};
