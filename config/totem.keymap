// 利便性を考えて、デフォルトではなくhttps://github.com/note96e/thorium/ ベース　Mityoku（QWERTY）配列

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            timeout-ms = <50>;
        };

        ZenHan {
            bindings = <&kp LA(SPACE)>;
            key-positions = <12 13>;
            timeout-ms = <50>;
        };

        Num-Dot-Combo {
            bindings = <&kp DOT>;
            key-positions = <27 28>;
            timeout-ms = <20>;
            layers = <1>;
        };

        zaq {
            bindings = <&zaq_macro>;
            key-positions = <0 1>;
            layers = <2>;
        };

        ndq {
            bindings = <&ndq_id_macro>;
            key-positions = <1 2>;
            layers = <2>;
        };

        pc {
            bindings = <&PC_macro>;
            key-positions = <2 3>;
            layers = <2>;
        };

        kakko_start {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <7 6>;
            layers = <1>;
        };

        kakko_end {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <1>;
        };
    };

    macros {
        zaq_macro: zaq_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp A &kp Q &kp N1 &kp DQT &kp LS(W) &kp LS(S) &kp LS(X)>;
            label = "ZAQ_MACRO";
        };

        ndq_id_macro: nsq_id_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N4 &kp N4 &kp N5 &kp N6 &kp N3 &kp N6 &kp N0>;
            label = "NSQ_ID_MACRO";
        };

        PC_macro: PC_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp S &kp D &kp F &kp SEMI &kp L &kp K &kp J>;
            label = "PC_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────
        // BASE（jurf 60% Miryoku　Base）
        // ─────────────────────────────

        base_layer {
            display-name = "BASE";
            bindings = <
           &kp Q  &kp W  &kp E  &kp R  &kp T              &kp Y                  &kp U  &kp I      &kp O    &kp P
           &kp A  &kp S  &kp D  &kp F  &kp G              &kp H                  &kp J  &kp K      &kp L    &kp MINUS
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B              &kp N                  &kp M  &kp COMMA  &kp DOT  &lt 4 SLASH  &kp ENTER
                         &mo 4  &mo 2  &mt RCTRL SPACE    &mt RIGHT_SHIFT ENTER  &mo 3  &mo 5
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
           &none         &none           &kp UP_ARROW    &none            &none        &kp SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
           &none         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none        &kp ASTERISK  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&kp LSHFT  &kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT    &kp LCTRL        &none        &kp KP_N0     &kp KP_N1  &kp KP_N2  &kp KP_N3  &tog 1        &kp RSHFT
                                         &none           &kp TAB          &kp SPACE    &kp KP_ENTER  &none      &none
            >;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
           &none         &none      &none          &none       &none              &kp C_AL_SCREENSAVER   &kp PAUSE_BREAK   &kp MINUS         &kp EQUAL          &none
           &kp CAPSLOCK  &kp TAB    &kp BACKSPACE  &kp ESCAPE  &kp DELETE         &kp SCROLLLOCK         &none             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&kp LSHFT  &kp LWIN      &kp LSHFT  &kp LEFT_ALT   &kp LCTRL   &kp PRINTSCREEN    &none                  &none             &kp SEMICOLON     &kp SQT            &kp BACKSLASH  &kp RSHFT
                                    &mo 4          &trans      &lt 8 LC(SPACE)    &mt RIGHT_SHIFT ENTER  &lt 7 INT_HENKAN  &mo 5
            >;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
           &kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3  &kp NUMBER_4        &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
           &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp K_PREV          &kp K_STOP       &kp K_PP      &kp K_NEXT    &none         &none         &none
&kp LSHFT  &trans        &trans             &trans        &trans              &kp LC(LS(O))    &none         &kp RCTRL     &kp RALT      &kp RSHFT     &kp RIGHT_GUI  &kp RSHFT
                                            &mo 4         &lt 6 INT_MUHENKAN  &kp SPACE        &lt 8 ENTER   &trans        &mo 5
            >;
        };

        func_layer {
            display-name = "func";
            bindings = <
           &none         &none           &none         &none      &none        &none                  &kp F7  &kp F8  &kp F9  &none
           &kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &none        &kp PAGE_UP            &kp F4  &kp F5  &kp F6  &tog 1
&kp LSHFT  &none         &kp F10         &kp F11       &kp F12    &mo 8        &kp PAGE_DOWN          &kp F1  &kp F2  &kp F3  &trans  &kp RSHFT
                                         &trans        &none      &kp SPACE    &mt RIGHT_SHIFT ENTER  &none   &mo 5
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
           &kp ESCAPE    &mkp LCLK       &mkp MCLK     &mkp RCLK  &kp C_AC_HOME    &mkp MCLK        &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP
           &kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &kp END          &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&kp LSHFT  &none         &none           &kp INSERT    &kp PG_UP  &kp PAGE_DOWN    &msc SCRL_RIGHT  &kp LEFT        &kp DOWN        &kp UP           &kp RIGHT       &kp RSHFT
                                         &none         &none      &none            &none            &none           &trans
            >;
        };

        lmod_layer {
            bindings = <
           &kp Q         &kp W           &kp E          &kp R      &kp T        &kp Y    &kp U   &kp I      &kp O       &kp P
           &kp LEFT_GUI  &kp LEFT_SHIFT  &kp LALT       &kp LCTRL  &kp G        &kp H    &kp J   &kp K      &kp L       &kp MINUS
&kp LSHFT  &kp LEFT_GUI  &kp LEFT_SHIFT  &kp RIGHT_ALT  &kp LCTRL  &kp B        &kp N    &kp M   &kp COMMA  &kp PERIOD  &kp SLASH  &kp RSHFT
                                         &none          &trans     &kp SPACE    &kp RET  &trans  &none
            >;
        };

        rmod_layer {
            bindings = <
           &kp Q  &kp W  &kp E  &kp R   &kp T        &kp Y    &kp U      &kp I          &kp O      &kp P
           &kp A  &kp S  &kp D  &kp F   &kp G        &kp H    &kp RCTRL  &kp RIGHT_ALT  &kp RSHFT  &kp RIGHT_GUI
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V   &kp B        &kp N    &kp RCTRL  &kp RIGHT_ALT  &kp RSHFT  &kp RIGHT_GUI  &kp RSHFT
                         &none  &trans  &kp SPACE    &kp RET  &trans     &none
            >;
        };

        adjust_layer {
            bindings = <
                &bootloader   &sys_reset    &none         &bt BT_CLR    &bt BT_CLR_ALL    &sys_reset      &none  &none  &none  &none
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &out OUT_TOG    &none  &none  &none  &none
&kp LEFT_SHIFT  &out OUT_USB  &out OUT_BLE  &bt BT_PRV    &bt BT_NXT    &trans            &studio_unlock  &none  &none  &none  &none  &kp RSHFT
                                            &none         &trans        &none             &none           &none  &none
            >;
        };
    };
};